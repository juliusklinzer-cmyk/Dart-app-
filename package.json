{
  "name": "dart-turnier",
  "version": "1.0.0",
  "description": "Jeder-gegen-jeden Dartturnier (501 Double Out) als offline-fähige Web-App",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8080",
    "server": "node server/main.mjs",
    "test": "node tests/e2e.mjs",
    "test:api": "node tests/api.mjs",
    "test:engine": "node tests/checkout-engine.mjs",
    "test:konto": "node tests/konto.mjs",
    "test:liga": "node tests/liga-daten.mjs",
    "test:mail": "node tests/mail.mjs",
    "test:mitteilungen": "node tests/mitteilungen.mjs",
    "liga": "node tools/liga-import.mjs --pruefen",
    "test:alle": "npm run test:engine && npm run test:liga && npm run test:mail && npm run test:mitteilungen && npm test && npm run test:api && npm run test:konto",
    "invite": "node server/scripts/invite-hash.mjs",
    "build": "node build-single.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
