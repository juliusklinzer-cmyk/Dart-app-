# Lokale Einstellungen fürs Deployen (bash deploy/deploy.sh).
# Kopieren nach .env im Repo-Wurzelverzeichnis und ausfüllen.
# .env steht in .gitignore – sie gehört NIE ins Repo.

# Pflicht: SSH-Ziel des Servers
DARTS_SERVER=root@<server-ip>

# Optional
DARTS_ZIEL=/opt/dart-turnier
DARTS_URL=https://darts.example.de
